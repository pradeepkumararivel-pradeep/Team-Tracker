# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/teamtracker

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_987654321
JWT_EXPIRE=7d

# AI Integration (OpenAI / Compatible Provider)
AI_PROVIDER=openai
AI_API_KEY=sk-proj-your-api-key-here
AI_MODEL=gpt-4o-mini

# Email Service (Optional for Notifications / Password Reset)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
